@model BorrowForm
@{
    ViewData["Title"] = "Borrow a book";
}
<div class="card form-card mx-auto" style="max-width:40rem">
    <div class="card-header py-3">
        <h1 class="h4 mb-0">➕ Borrow a book</h1>
        <small class="opacity-75">A member may have up to 3 books out. A loan lasts 1 to 30 days.</small>
    </div>
    <form asp-action="Borrow" method="post" class="card-body p-4">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="MemberId" class="form-label fw-semibold">👤 Member</label>
                <select asp-for="MemberId" asp-items="ViewBag.Members" class="form-select">
                    <option value="">(choose a member)</option>
                </select>
                <span asp-validation-for="MemberId" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="BookId" class="form-label fw-semibold">📘 Book</label>
                <select asp-for="BookId" asp-items="ViewBag.Books" class="form-select">
                    <option value="">(choose a book)</option>
                </select>
                <span asp-validation-for="BookId" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="DaysAllowed" class="form-label fw-semibold">📅 Days allowed</label>
                <div class="input-group">
                    <input asp-for="DaysAllowed" class="form-control" />
                    <span class="input-group-text">days</span>
                </div>
                <span asp-validation-for="DaysAllowed" class="text-danger"></span>
            </div>
        </div>
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary px-4">✔ Borrow</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}