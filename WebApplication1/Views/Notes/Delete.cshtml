@model library.Models.Note

@{
    ViewData["Title"] = "Delete Note";
}

<div class="container mt-4">
    <h2>Delete Note</h2>

    <div class="alert alert-warning">
        Are you sure you want to delete this note? This action cannot be undone.
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <h4>@Model.Title</h4>

            <p>
                @(string.IsNullOrWhiteSpace(Model.Body)
                                ? "No body provided."
                                : Model.Body)
            </p>

            <p class="text-muted">
                Created on: @Model.CreatedOn.ToString("MMM dd, yyyy")
            </p>

            <form asp-action="DeleteConfirmed"
                  asp-route-id="@Model.NoteId"
                  method="post">

                <input type="hidden" name="id" value="@Model.NoteId" />

                <button type="submit" class="btn btn-danger">
                    Yes, Delete
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</div>